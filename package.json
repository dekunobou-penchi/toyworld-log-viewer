{
    "name": "toyworld-log-viewer",
    "version": "0.1.0",
    "private": true,
    "description": "toyWorld の実験ログ（data/experiments）を可視化するビューア",
    "type": "module",
    "packageManager": "pnpm@11.5.0",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "pnpm --parallel --filter \"./packages/*\" dev",
        "build": "pnpm --filter @viewer/frontend build",
        "start": "pnpm --filter @viewer/server start",
        "typecheck": "pnpm --filter \"./packages/*\" typecheck"
    },
    "devDependencies": {
        "typescript": "^5.6.0"
    }
}
